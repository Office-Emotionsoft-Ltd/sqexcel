---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { render } from 'astro:content';
import { getReleaseNotes, getDisplayVersion } from '../../../lib/releaseNotes';

const channelLabels: Record<string, string> = {
  preview: 'Preview版',
  rc: 'リリース候補（RC）',
  ga: '正式版',
};

const dateFormatter = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const entries = await getReleaseNotes('ja');
const rendered = await Promise.all(entries.map((entry) => render(entry)));

// StarlightPageは本文中の見出しを自動検出しないため、右側の「このページの内容」用に明示的に渡す
const headings = entries.map((entry) => ({
  depth: 2,
  slug: entry.data.version,
  text: `v${getDisplayVersion(entry)} — ${dateFormatter.format(entry.data.date)}`,
}));
---

<StarlightPage
  frontmatter={{ title: 'リリースノート', description: 'SQExcelのバージョンごとの変更履歴。' }}
  headings={headings}
>
  {entries.length === 0 && <p>まだ公開されたリリースはありません。</p>}
  {entries.map((entry, i) => {
    const { Content } = rendered[i];
    return (
      <section id={entry.data.version}>
        <h2>
          v{getDisplayVersion(entry)} — {dateFormatter.format(entry.data.date)}
          <span class="release-channel">{channelLabels[entry.data.channel]}</span>
        </h2>
        <Content />
      </section>
    );
  })}
</StarlightPage>

<style>
  .release-channel {
    display: inline-block;
    margin-left: 0.6rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--sl-color-gray-5);
    font-size: 0.7rem;
    font-weight: 600;
    vertical-align: middle;
  }
</style>
