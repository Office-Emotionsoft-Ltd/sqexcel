---
import { Image } from 'astro:assets';
import LpLayout from '../../layouts/LpLayout.astro';
import Carousel from '../../components/lp/Carousel.astro';

import heroPart from '../../content/docs/ja/docs/images/lp/hero-parts.jpg';
import dbSqlServer from '../../content/docs/ja/docs/images/lp/db-sqlserver.jpg';
import dbOracle from '../../content/docs/ja/docs/images/lp/db-oracle.jpg';
import dbPostgresql from '../../content/docs/ja/docs/images/lp/db-postgresql.jpg';
import dbMysql from '../../content/docs/ja/docs/images/lp/db-mysql.jpg';
import dbMariadb from '../../content/docs/ja/docs/images/lp/db-mariadb.jpg';
import dbSqlite from '../../content/docs/ja/docs/images/lp/db-sqlite.jpg';
import featureQuickMode from '../../content/docs/ja/docs/images/lp/feature-quickmode.jpg';
import featureInputSheet from '../../content/docs/ja/docs/images/lp/feature-inputsheet.jpg';
import featureDataCreation from '../../content/docs/ja/docs/images/lp/feature-datacreation.jpg';
import featureFullDml from '../../content/docs/ja/docs/images/lp/feature-fulldml.jpg';

const databases = [
  { name: 'SQL Server', version: '対応バージョン：SQL Server 2022（内部バージョン 16.0）以降', image: dbSqlServer },
  { name: 'Oracle', version: '対応バージョン：Oracle AI Database 23ai以降', image: dbOracle },
  { name: 'PostgreSQL', version: '対応バージョン： PostgreSQL 18以降', image: dbPostgresql },
  { name: 'MySQL', version: '対応バージョン：MySQL 8.4以降', image: dbMysql },
  { name: 'MariaDB', version: '対応バージョン：MariaDB 11.4以降', image: dbMariadb },
  { name: 'SQLite', version: '対応バージョン：SQLite 3.53.x以降', image: dbSqlite },
];

const features = [
  {
    title: 'クイックモード',
    description: '素早くDBに接続して直ぐに入力シート操作を開始。',
    image: featureQuickMode,
  },
  {
    title: 'リッチな入力シート',
    description: 'データ入出力双方に利用出来て、テーブル・項目情報が一目で俯瞰できる入力シート。',
    image: featureInputSheet,
  },
  {
    title: '様々な入力シートデータ作成方法',
    description: '入力シートデータ作成方法は自由。関数を使っても良し、Microsoft 365 Copilotを使っても良し。',
    image: featureDataCreation,
  },
  {
    title: 'データ全処理・SQL出力対応',
    description: 'INSERT/UPDATE/UPSERT/DELETEの全処理に対応。SQL出力、エラー原因の出力にも対応。',
    image: featureFullDml,
  },
];
---

<LpLayout
  title="SQExcel - SQL Serverほか6DBとExcelを行き来させるデータ交換ツール"
  description="SQExcel（SQL2Excel）は、SQL Server・Oracle・PostgreSQL・MySQL・MariaDB・SQLiteとExcelの間でデータをやり取りできるWindowsアプリケーションです。"
>
  <section class="lp-hero">
    <div class="lp-hero-inner">
      <div class="lp-hero-copy">
        <h1>SQExcel</h1>
        <p class="lp-hero-tagline">SQL ServerやOracle他、主要6種類のDBとExcelを行き来させるデータ交換ツール</p>
        <a class="lp-download-button" href="/ja/download/">
          <span class="lp-download-icon">&#8595;</span>
          <span>
            <span class="lp-download-label">Download</span>
            <span class="lp-download-version">v0.5.1 - Aug 20, 2026</span>
          </span>
        </a>
      </div>
      <div class="lp-hero-image">
        <Image src={heroPart} alt="SQExcelのホーム画面とIO操作画面のスクリーンショット" width={1200} height={800} loading="eager" />
      </div>
    </div>
  </section>

  <section class="lp-section">
    <div class="lp-section-inner">
      <div class="lp-section-heading">
        <h2>対応データベース</h2>
        <p>簡単に接続して直ぐに使える。主要6つのDBとのExcelを介したデータのやり取り！</p>
      </div>
      <Carousel id="db-carousel" label="対応データベース" count={databases.length}>
        {databases.map((db) => (
          <article class="lp-card" data-carousel-card>
            <Image src={db.image} alt={`${db.name}での実行結果画面`} width={560} height={380} />
            <h3>{db.name}</h3>
            <p>{db.version}</p>
          </article>
        ))}
      </Carousel>
    </div>
  </section>

  <section class="lp-section lp-section-alt">
    <div class="lp-section-inner">
      <div class="lp-section-heading">
        <h2>機能概要</h2>
        <p>リッチな入力シートを作成して初期データ投入からデータメンテナンスまであらゆる開発シーンで利用可能な豊富な機能を提供します。</p>
      </div>
      <Carousel id="feature-carousel" label="機能概要" count={features.length}>
        {features.map((feature) => (
          <article class="lp-card" data-carousel-card>
            <Image src={feature.image} alt={`${feature.title}の画面キャプチャ（ダミー）`} width={560} height={380} />
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>
        ))}
      </Carousel>
    </div>
  </section>
</LpLayout>

<style>
  .lp-hero-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    display: grid;
    grid-template-columns: 35fr 65fr;
    gap: 3rem;
    align-items: center;
  }

  .lp-hero h1 {
    font-family: var(--lp-font-logo);
    font-weight: 900;
    font-size: 3rem;
    margin: 0 0 1rem;
  }

  .lp-hero-tagline {
    font-family: var(--lp-font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--lp-text-muted);
    margin: 0 0 2rem;
    max-width: 32rem;
  }

  .lp-download-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--lp-accent);
    color: white;
    text-decoration: none;
    padding: 0.9rem 1.5rem;
    border-radius: 0.6rem;
    font-weight: 600;
  }

  .lp-download-button:hover {
    background: var(--lp-accent-hover);
  }

  .lp-download-icon {
    font-size: 1.3rem;
  }

  .lp-download-label {
    display: block;
    font-size: 1.05rem;
  }

  .lp-download-version {
    display: block;
    font-size: 0.75rem;
    font-weight: 400;
    opacity: 0.85;
  }

  .lp-hero-image :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    box-shadow: var(--lp-card-shadow);
  }

  .lp-section-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3.5rem 1.5rem;
  }

  .lp-section-alt {
    background: var(--lp-bg-alt);
  }

  .lp-section-heading {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .lp-section-heading h2 {
    font-size: 1.6rem;
    margin: 0;
    white-space: nowrap;
  }

  .lp-section-heading p {
    margin: 0;
    color: var(--lp-text-muted);
  }

  .lp-card {
    flex: none;
    width: 20rem;
    scroll-snap-align: start;
    background: var(--lp-card-bg);
    border: 1px solid var(--lp-border);
    border-radius: 0.75rem;
    padding: 1rem;
    box-shadow: var(--lp-card-shadow);
  }

  .lp-card :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .lp-card h3 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
  }

  .lp-card p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--lp-text-muted);
  }

  @media (max-width: 800px) {
    .lp-hero-inner {
      grid-template-columns: 1fr;
      padding-top: 2.5rem;
    }

    .lp-hero h1 {
      font-size: 2.25rem;
    }
  }
</style>
