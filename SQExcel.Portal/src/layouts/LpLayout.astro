---
import '@fortawesome/fontawesome-free/css/fontawesome.min.css';
import '@fortawesome/fontawesome-free/css/solid.min.css';
import Logo from '../components/lp/Logo.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// GitHub Pagesのプロジェクトサイト（base設定あり）でも正しくリンクするよう、
// astro.config.mjsのbaseを反映したimport.meta.env.BASE_URLを前置する
// （BASE_URLは末尾スラッシュが保証されないため、ここで正規化する）
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const navLinks = [
  { href: `${base}ja/`, label: 'ホーム', icon: 'fa-house' },
  { href: `${base}ja/news/`, label: 'ニュース', icon: 'fa-newspaper' },
  { href: `${base}ja/docs/`, label: 'ドキュメント', icon: 'fa-file-lines' },
  { href: `${base}ja/download/`, label: 'ダウンロード', icon: 'fa-download' },
];
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@400;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="lp-header">
      <div class="lp-header-inner">
        <Logo />
        <nav class="lp-nav">
          {navLinks.map((link) => (
            <a href={link.href}><i class={`fa-solid ${link.icon}`} aria-hidden="true"></i><span>{link.label}</span></a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="lp-footer">
      <div class="lp-footer-inner">
        <div class="lp-footer-brand">
          <Logo class="lp-logo-compact" />
          <p class="lp-footer-copyright">著作権© 2026 SQExcel</p>
        </div>
        <div class="lp-footer-col">
          <h3>ページ</h3>
          <ul>
            {navLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
        <div class="lp-footer-col">
          <h3>リンク</h3>
          <ul>
            <li><a href="https://www.emotionsoft.net" target="_blank" rel="noopener noreferrer">エモーションソフト（開発会社）</a></li>
          </ul>
        </div>
        <div class="lp-footer-col">
          <h3>サポート</h3>
          <ul>
            <li><a href="https://github.com/Office-Emotionsoft-Ltd/sqexcel/issues" target="_blank" rel="noopener noreferrer">バグの報告</a></li>
            <li><a href="https://github.com/Office-Emotionsoft-Ltd/sqexcel/discussions" target="_blank" rel="noopener noreferrer">ディスカッション</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --lp-bg: #ffffff;
    --lp-bg-alt: #f8fafc;
    --lp-text: #1e293b;
    --lp-text-muted: #64748b;
    --lp-accent: #2563eb;
    --lp-accent-hover: #1d4ed8;
    --lp-border: #e2e8f0;
    --lp-card-bg: #ffffff;
    --lp-card-shadow: 0 2px 10px rgba(15, 23, 42, 0.08);
    --lp-font-logo: "Segoe UI Black", "Segoe UI", -apple-system, sans-serif;
    --lp-font-heading: "BIZ UDPGothic", "BIZ UDGothic", "Yu Gothic", sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --lp-bg: #0f172a;
      --lp-bg-alt: #1e293b;
      --lp-text: #e2e8f0;
      --lp-text-muted: #94a3b8;
      --lp-accent: #60a5fa;
      --lp-accent-hover: #93c5fd;
      --lp-border: #334155;
      --lp-card-bg: #1e293b;
      --lp-card-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
    }
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    font-family: system-ui, -apple-system, "Segoe UI", "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif;
    background: var(--lp-bg);
    color: var(--lp-text);
    line-height: 1.7;
  }

  a {
    color: inherit;
  }
</style>

<style>
  .lp-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--lp-bg);
    border-bottom: 1px solid var(--lp-border);
  }

  .lp-header-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.9rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .lp-nav {
    display: flex;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  .lp-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    font-family: var(--lp-font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--lp-text-muted);
  }

  .lp-nav a i {
    font-size: 0.85em;
  }

  .lp-nav a:hover {
    color: var(--lp-accent);
  }

  .lp-footer-brand .lp-logo-compact {
    transform: scale(0.85);
    transform-origin: left center;
  }

  .lp-footer {
    border-top: 1px solid var(--lp-border);
    background: var(--lp-bg-alt);
    margin-top: 4rem;
  }

  .lp-footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2rem;
  }

  .lp-footer-copyright {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: var(--lp-text-muted);
  }

  .lp-footer-col h3 {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--lp-text);
  }

  .lp-footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lp-footer-col a {
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--lp-accent);
  }

  .lp-footer-col a:hover {
    color: var(--lp-accent-hover);
  }

  @media (max-width: 640px) {
    .lp-footer-inner {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
