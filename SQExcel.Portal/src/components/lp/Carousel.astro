---
interface Props {
  id: string;
  label: string;
  count: number;
}

const { id, label, count } = Astro.props;
---

<div class="lp-carousel-wrap" data-carousel-id={id}>
  <div class="lp-carousel">
    <button
      type="button"
      class="lp-carousel-arrow lp-carousel-arrow-prev"
      aria-label={`${label}: 前へ`}
      data-carousel-prev={id}
    >
      &#8249;
    </button>
    <div class="lp-carousel-track" id={id}>
      <slot />
    </div>
    <button
      type="button"
      class="lp-carousel-arrow lp-carousel-arrow-next"
      aria-label={`${label}: 次へ`}
      data-carousel-next={id}
    >
      &#8250;
    </button>
  </div>
  <div class="lp-carousel-dots" aria-hidden="true">
    {Array.from({ length: Math.max(count - 1, 0) }).map(() => (
      <span class="lp-carousel-dot" data-carousel-dot={id} />
    ))}
  </div>
</div>

<style>
  .lp-carousel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lp-carousel-track {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 0.5rem 0.25rem;
    flex: 1;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .lp-carousel-track::-webkit-scrollbar {
    display: none;
  }

  .lp-carousel-arrow {
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    border: 1px solid var(--lp-border);
    background: var(--lp-card-bg);
    color: var(--lp-accent);
    font-size: 1.9rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--lp-card-shadow);
  }

  .lp-carousel-arrow:hover {
    border-color: var(--lp-accent);
  }

  .lp-carousel-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .lp-carousel-dot {
    display: block;
    width: 0.6rem;
    height: 0.6rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--lp-border);
  }

  .lp-carousel-dot.is-active {
    background: var(--lp-accent);
  }

  @media (max-width: 640px) {
    .lp-carousel-arrow {
      display: none;
    }
  }
</style>

<script>
  function setupCarousel(root: HTMLElement) {
    const id = root.dataset.carouselId;
    if (!id) return;

    const track = document.getElementById(id);
    if (!track) return;

    const prevButton = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const nextButton = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-carousel-dot]'));
    const cards = Array.from(track.querySelectorAll<HTMLElement>('[data-carousel-card]'));
    const count = cards.length;
    if (count === 0 || dots.length === 0) return;

    function cardStep() {
      const gap = parseFloat(getComputedStyle(track!).columnGap || '0');
      return cards[0].getBoundingClientRect().width + gap;
    }

    function maxScrollLeft() {
      return Math.max(track!.scrollWidth - track!.clientWidth, 0);
    }

    // インジケータはメインコンテナ左端にあるパネル番号を表示するだけの読み取り専用UI。
    // ドットの数は「パネル数-1」（末尾は右端フラッシュ状態を示す）。
    function targetForDot(index: number) {
      if (index >= dots.length - 1) return maxScrollLeft();
      return Math.min(index * cardStep(), maxScrollLeft());
    }

    function nearestDotIndex() {
      const max = maxScrollLeft();
      if (max <= 0) return 0;
      if (track!.scrollLeft >= max - 1) return dots.length - 1;
      const step = cardStep();
      if (step === 0) return 0;
      const index = Math.round(track!.scrollLeft / step);
      return Math.min(Math.max(index, 0), Math.max(dots.length - 2, 0));
    }

    let activeIndex = 0;

    // 無限巡回：右端で次へ→先頭へ、左端で前へ→右端（末尾ドット）へ。隣を飛ばさず必ず隣接ドットへ移動する。
    function scrollToDot(index: number) {
      activeIndex = ((index % dots.length) + dots.length) % dots.length;
      track!.scrollTo({ left: targetForDot(activeIndex), behavior: 'smooth' });
    }

    function updateDots() {
      activeIndex = nearestDotIndex();
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === activeIndex));
    }

    prevButton?.addEventListener('click', () => scrollToDot(activeIndex - 1));
    nextButton?.addEventListener('click', () => scrollToDot(activeIndex + 1));

    let ticking = false;
    track.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateDots();
        ticking = false;
      });
    });

    updateDots();
  }

  document
    .querySelectorAll<HTMLElement>('[data-carousel-id]')
    .forEach((root) => setupCarousel(root));
</script>
