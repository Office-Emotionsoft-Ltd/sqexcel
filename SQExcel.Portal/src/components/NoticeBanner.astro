---
// 告知を出すときだけ true にする。解除時は false にするだけでよい。
const { show = true, href = "/ja/news/" } = Astro.props;
---

{
  show && (
    <div class="notice-banner" role="status">
      <i
        class="fa-solid fa-circle-info notice-banner__icon"
        aria-hidden="true"
      />
      <p class="notice-banner__text">
        最新版のインストーラーがMcAfeeで誤検知される問題は解決しています。
        <a href={href}>詳細はニュースをご確認ください。</a>
      </p>
    </div>
  )
}

<style>
  .notice-banner {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin: 0 0 1.5rem;
    padding: 0.8rem 1rem;
    background: #fbdada;
    color: #3d2e00;
    border: 1px solid #ffcece;
    border-left: 6px solid #ffcece;
    border-radius: 6px;
    line-height: 1.6;
  }
  <!-- .notice-banner__icon {
    font-size: 1.8rem;
    line-height: 1.5;
    vertical-align: middle;
  }
  -- > .notice-banner__icon {
    font-size: 1.8rem;
    line-height: 1.5;
    vertical-align: middle;
  }
  .notice-banner__text {
    margin: 0;
  }
  .notice-banner a {
    color: #8a4b00;
    font-weight: 600;
    text-decoration: underline;
  }
  .notice-banner__icon {
    flex-shrink: 0;
    font-size: 1.1em;
    line-height: calc(
      1.6em / 1.1
    ); /* 本文の line-height 1.6 と同じ高さにする */
  }
</style>
